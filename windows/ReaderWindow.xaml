<Window x:Class="NTGrego.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NT Grego" Width="980" Height="620" MinWidth="640" MinHeight="380"
        Background="{StaticResource Paper}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Barra superior -->
        <DockPanel Grid.ColumnSpan="2" Margin="10,6" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="‹" Style="{StaticResource IconBtn}" FontSize="28" ToolTip="Versículo anterior (←)" Click="Prev_Click" />
            <Button DockPanel.Dock="Left" Content="›" Style="{StaticResource IconBtn}" FontSize="28" ToolTip="Versículo seguinte (→)" Click="Next_Click" />
            <Button DockPanel.Dock="Right" Content="↗" Style="{StaticResource IconBtn}" FontSize="18" ToolTip="Abrir no YouVersion (TB)" Click="Web_Click" />
            <Button DockPanel.Dock="Right" Content="☀" Style="{StaticResource IconBtn}" FontSize="18" ToolTip="Trecho do dia (Home)" Click="Today_Click" />
            <TextBlock x:Name="RefText" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}"
                       VerticalAlignment="Center" Margin="12,0" />
        </DockPanel>

        <!-- Texto -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,4,24,24">
            <StackPanel>
                <TextBlock x:Name="GreekText" FontFamily="{StaticResource GreekFont}" FontSize="28" LineHeight="44"
                           TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
                <TextBlock Text="Clique numa palavra para ver a análise" FontSize="12" Margin="0,8,0,0" Foreground="{StaticResource Muted}" />
                <Border Height="1" Background="#22000000" Margin="0,20,0,0" />
                <TextBlock Text="TB · TRADUÇÃO BRASILEIRA" FontSize="12" FontWeight="Bold" Margin="0,16,0,4" Foreground="{StaticResource Accent}" />
                <TextBlock x:Name="TbText" FontSize="18" LineHeight="28" TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Painel de análise -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Bar}" Padding="22,18">
            <StackPanel>
                <TextBlock x:Name="PWord" FontFamily="{StaticResource GreekFont}" FontSize="30" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                <TextBlock x:Name="PLemma" FontFamily="{StaticResource GreekFont}" FontSize="19" Foreground="{StaticResource Accent}" Margin="0,2,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="PGloss" FontSize="15" FontStyle="Italic" Foreground="{StaticResource Ink}" Margin="0,2,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="PPos" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,14,0,0" />
                <TextBlock x:Name="PDetails" FontSize="14" LineHeight="22" Foreground="{StaticResource Ink}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
